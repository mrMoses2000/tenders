[Unit]
Description=Procurement Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tenders
EnvironmentFile=%h/tenders/.env
ExecStart=%h/tenders/.venv/bin/procurement-bot bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
