# Required
POSTGRES_DSN=postgresql:///procurement_bot?host=/var/run/postgresql
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs. The runtime is deny-by-default.
TELEGRAM_ALLOWED_USER_IDS=
# One-time owner bootstrap when the numeric ID is not known. After the first
# exact match, PostgreSQL pins the numeric ID and username is no longer trusted.
TELEGRAM_BOOTSTRAP_USERNAMES=

# Runtime
LOG_LEVEL=INFO
POLL_TIMEOUT_SECONDS=30
TELEGRAM_INGRESS_CONCURRENCY=8
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=300
MAX_JOB_ATTEMPTS=5

# Private files. Keep these outside Git in production.
MEDIA_ROOT=./var/media
RESULTS_ROOT=./var/results
MAX_SOURCE_FILE_BYTES=2147483648
TELEGRAM_CLOUD_DOWNLOAD_LIMIT_BYTES=20971520
MAX_AUDIO_DURATION_SECONDS=3600
TELEGRAM_API_BASE_URL=

# AGY intake extractor
AGY_EXECUTABLE=agy
AGY_MODEL=gemini-3.8-flash-high
AGY_TIMEOUT_SECONDS=240
AGY_CONCURRENCY=2
# Parser-only HOME: contains auth token, but no browser MCPs or user skills.
AGY_HOME=./var/agy-home
AGY_AUTH_TOKEN_SOURCE=~/.gemini/antigravity-cli/antigravity-oauth-token

# Read-only browser research. Keep disabled until the one pinned MCP command is audited.
# Runtime provisions a dedicated HOME from AGY_AUTH_TOKEN_SOURCE and this exact config.
BROWSER_RESEARCH_ENABLED=false
AGY_BROWSER_HOME=./var/agy-browser-home
AGY_BROWSER_MCP_SERVER_NAME=playwright
# Example shape only; pin the package/version in production. No embedded `env` is allowed.
AGY_BROWSER_MCP_SERVER_JSON=
AGY_BROWSER_TIMEOUT_SECONDS=240
AGY_BROWSER_CONCURRENCY=1

# Voice. The API key remains in the referenced private file; it is not copied here.
VOICE_PROVIDER=assemblyai
ASSEMBLYAI_ENV_FILE=/home/moses/audio_transcription/.env
ASSEMBLYAI_KEY_NAME=ASSEMBLI_AI_5
ASSEMBLYAI_TIMEOUT_SECONDS=10800
TRANSCRIPTION_MIN_LANGUAGE_CONFIDENCE=0.55

# External messaging is fail-closed. Keep false until supplier-contact approval UI is enabled.
WAHA_ENABLED=false
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TIMEOUT_SECONDS=15

# Authenticated inbound webhook; expose through a TLS reverse proxy, not directly.
WAHA_WEBHOOK_ENABLED=false
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_BIND_HOST=127.0.0.1
WAHA_WEBHOOK_ALLOW_PRIVATE_BIND=false
WAHA_WEBHOOK_PORT=8081
